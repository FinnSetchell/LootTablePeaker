{
    "schemaVersion": 1,
    "id": "${id}",
    "version": "${version}",
    "name": "${name}",
    "description": "${description}",
    "authors": [
        "${author}"
    ],
    "contact": {
        "homepage": "https://github.com/FinnSetchell/LootTablePeaker",
        "sources": "https://github.com/FinnSetchell/LootTablePeaker",
        "issues": "https://github.com/FinnSetchell/LootTablePeaker/issues"
    },
    "license": "${license}",
    "icon": "assets/${id}/icon.png",
